# Frontend environment variables
# Point frontend API client to your backend base URL
# Examples:
# VITE_API_BASE_URL=http://localhost:3001
# VITE_API_BASE_URL=https://api.staging.clario.com
VITE_API_BASE_URL=http://localhost:3001

# Public reviewer email that diverts to the backend demo reviewer login flow.
VITE_PAYSTACK_REVIEW_EMAIL=paystack-review@margin-finance.com
